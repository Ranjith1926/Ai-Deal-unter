# TLS is automatic (Let's Encrypt) when SITE_ADDRESS is a public domain with DNS pointing at this host.
# For a local trial use SITE_ADDRESS=localhost (Caddy issues an internal certificate).
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Only the web app is public. /metrics and the API are reachable on the private network only.
	@internal path /metrics /metrics/* /health/* /docs /redoc /openapi.json
	respond @internal 404

	request_body {
		max_size 2MB
	}

	reverse_proxy frontend:3000 {
		# Caddy appends the real client address; the API trusts exactly one proxy hop (TRUSTED_PROXY_COUNT=1).
		header_up X-Forwarded-For {remote_host}
		health_uri /healthz
		health_interval 15s
	}
}
