# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL (change the password before any shared/production use) ---
POSTGRES_USER=dealhunter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dealhunter
DATABASE_URL=postgresql+asyncpg://dealhunter:change-me@postgres:5432/dealhunter

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth (used from Phase 2): generate with `openssl rand -hex 32` ---
JWT_SECRET=

# --- Marketplace credentials (leave empty to use mock providers) ---
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
# Blank = automatic (mock providers allowed unless APP_ENV=production). Set true/false to force.
USE_MOCK_PROVIDERS=

# --- Job schedules (optional overrides; defaults shown) ---
# PRICE_COLLECTION_MINUTES=30
# CATALOG_SYNC_MINUTES=360
# ALERT_CHECK_MINUTES=10
# NOTIFICATION_SEND_MINUTES=5
# RANKING_DAILY_HOUR_UTC=2
# CACHE_CLEANUP_HOURS=6
# PRICE_BATCH_SIZE=50

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000

# --- MCP server ---
BACKEND_API_URL=http://backend:8000

# Set true when serving over HTTPS so session cookies are Secure.
# COOKIE_SECURE=true

# --- AI shopping assistant (disabled until a key is set) ---
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_EFFORT=medium
# ASSISTANT_RATE_LIMIT_PER_HOUR=30
# MCP_SERVER_URL=http://mcp-server:8765/mcp

# --- Notifications (Phase 10). A channel with no credentials is off; its messages wait, then expire. ---
# Email via SMTP. In development the bundled Mailpit catches everything (UI: http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
# SMTP_USERNAME=
# SMTP_PASSWORD=
EMAIL_FROM=AI Deal Hunter <no-reply@localhost>
# Telegram: create a bot with @BotFather, then users message the bot and save their chat ID in Profile.
TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=YourDealBot
# Web Push: generate a pair with  docker compose run --rm backend python -m app.cli vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost
