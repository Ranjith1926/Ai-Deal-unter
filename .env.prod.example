# Production settings. Copy to .env.prod (never commit it) and replace every CHANGE_ME.
APP_ENV=production
LOG_LEVEL=INFO
SITE_ADDRESS=deals.example.com
# Host ports Caddy listens on. Keep 80/443 for Let's Encrypt; change only for local trials.
HTTP_PORT=80
HTTPS_PORT=443
CORS_ORIGINS=https://deals.example.com
FRONTEND_URL=https://deals.example.com
COOKIE_SECURE=true

# Caddy is the single proxy in front of the app, so trust exactly one X-Forwarded-For hop.
TRUSTED_PROXY_COUNT=1

# Generate secrets with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME
METRICS_TOKEN=CHANGE_ME
POSTGRES_USER=dealhunter
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=dealhunter
# Must use the same password as POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://dealhunter:CHANGE_ME@postgres:5432/dealhunter
REDIS_URL=redis://redis:6379/0
BACKEND_API_URL=http://backend:8000
MCP_SERVER_URL=http://mcp-server:8765/mcp

# Sizing: API processes x (DB_POOL_SIZE + DB_MAX_OVERFLOW) must stay well under Postgres max_connections (100).
WEB_CONCURRENCY=4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
CELERY_CONCURRENCY=2
BACKUP_KEEP_DAYS=14

# Real marketplace credentials. Production never serves mock data: the API refuses to start if USE_MOCK_PROVIDERS=true.
# Without credentials a provider is reported as unavailable (see /health/providers) and the catalogue stays empty.
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Notifications. Use your mail provider's SMTP relay (port 587 + STARTTLS, or 465 + SMTP_SECURITY=ssl).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=AI Deal Hunter <no-reply@deals.example.com>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@deals.example.com

ANTHROPIC_API_KEY=
